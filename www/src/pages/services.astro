---
import Layout from '../components/Layout.astro';
import { services } from '../data/services.ts';

// Eyebrow count is computed from the data, zero-padded, per redesign-spec.md
// "Services" (`SERVICES · 07`, driven by services.length so it never drifts
// from the data file as services are added/removed).
const count = String(services.length).padStart(2, '0');
---

<Layout
  title="Services - NÍTIDA DIGITAL"
  description="Custom WordPress, Shopify, apps and integrations, SEO, AI in the workflow, cleanup & rescue, and hosting & care — seven services, each backed by a project you can see live."
  active="services"
>
  <section class="services-intro container">
    <div class="services-intro__grid">
      <div>
        <p class="eyebrow services-intro__eyebrow">SERVICES · {count}</p>
        <h1 class="h1 h1--48 services-intro__title">
          Seven things we do properly, instead of forty we'd do badly.
        </h1>
      </div>
      <p class="services-intro__lead">
        Every engagement starts the same way: a call, a written scope, a fixed first milestone.
        Then we build. Each capability below links to a project where you can see it running in
        production.
      </p>
    </div>
  </section>

  <section class="services-grid container">
    <div class="services-grid__list">
      {
        services.map((s) => (
          <div class="services-card">
            <div class="services-card__top">
              <span class="services-card__no">{s.no}</span>
              <span class="services-card__kind">{s.kind}</span>
            </div>
            <h3 class="services-card__title">{s.title}</h3>
            <p class="services-card__line">{s.line}</p>
            <ul class="services-card__items">
              {s.items.map((item) => (
                <li>
                  <i class="services-card__bullet" />
                  {item}
                </li>
              ))}
            </ul>
            {s.proof && (
              <a href={`/works#${s.proof.slug}`} class="services-card__proof">
                <span>{s.proof.label}</span>
                <span>→</span>
              </a>
            )}
          </div>
        ))
      }

      <div class="services-card services-card--cta">
        <div>
          <span class="services-card__no services-card__no--cta">08</span>
          <h3 class="services-card__title services-card__title--cta">
            Not sure which one you need?
          </h3>
          <p class="services-card__line">
            Send the problem, not the spec. We'll tell you what it actually takes — and if it
            isn't us, we'll say so.
          </p>
        </div>
        <a href="/contact" class="btn btn--primary services-card__cta-btn">START A PROJECT →</a>
      </div>
    </div>
  </section>

  <section class="services-band">
    <div class="container services-band__inner">
      <p class="services-band__text">
        Already running something that needs looking after? Hosting, backups, updates and
        monitoring are a service too.
      </p>
      <a href="/contact?need=care" class="services-band__cta">CONTACT →</a>
    </div>
  </section>
</Layout>
