---
import Layout from '../components/Layout.astro';
import { services } from '../data/services.ts';

---

<Layout
  title="Services - NÍTIDA DIGITAL"
  description="Custom WordPress, Shopify, apps and integrations, SEO, AI in the workflow, cleanup & rescue, and hosting & care — seven services, each backed by a project you can see live."
  active="services"
>
  <section class="services-intro container">
    <div class="services-intro__grid">
      <div>
        <p class="eyebrow services-intro__eyebrow">SERVICES</p>
        <h1 class="h1 h1--48 services-intro__title">
          Design, build, connect, keep running.
        </h1>
      </div>
      <p class="services-intro__lead">
        Ten years of shipping for the web, and a clear idea of what's worth doing.
      </p>
    </div>
  </section>

  <section class="services-grid container">
    <div class="services-grid__list">
      {
        services.map((s) => (
          <div class="services-card">
            <div class="services-card__top">
              <span class="services-card__kind">{s.kind}</span>
            </div>
            <h3 class="services-card__title" set:html={s.title} />
            <p class="services-card__line">{s.line}</p>
            <ul class="services-card__items">
              {s.items.map((item) => (
                <li>
                  <i class="services-card__bullet" />
                  {item}
                </li>
              ))}
            </ul>
            {s.proof && (
              <a href={`/works#${s.proof.slug}`} class="services-card__proof">
                <span>{s.proof.label}</span>
                <span>→</span>
              </a>
            )}
          </div>
        ))
      }

      <div class="services-card services-card--cta">
        <div>
          <div class="services-card__top services-card__top--cta">
            <span class="services-card__kind">MORE</span>
          </div>
          <h3 class="services-card__title services-card__title--cta">
            Something else in mind?
          </h3>
          <p class="services-card__line">
            If it lives on a screen, it's probably doable. We love challenges.
          </p>
        </div>
        <a href="/contact" class="btn btn--primary services-card__cta-btn">ASK ABOUT IT →</a>
      </div>
    </div>
  </section>
</Layout>
