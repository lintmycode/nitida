---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';

// Mockup 2a. Layout is given `stageHeader` so it skips rendering <Header>
// itself — we render it here, inside `.home-stage`, so it sits over the
// Game of Life canvas together with the hero and status bar.
---

<Layout
  title="NÍTIDA DIGITAL"
  description="Custom everything. Web design, websites, apps and workflow integrations — made for your business. With AI built in."
  stageHeader
>
  <div class="home-stage">
    <canvas id="life-canvas" class="home-stage__canvas"></canvas>

    <Header />

    <div class="home-hero container">
      <div class="home-hero__inner">
        <p class="eyebrow home-hero__eyebrow">NÍTIDA DIGITAL</p>
        <h1 class="h1 h1--hero home-hero__title">
          Sharp work for the web.
        </h1>
        <p class="home-hero__lead">
          Custom everything. Web design, websites, apps and workflow integrations — made for your business. With AI built in.
        </p>
        <div class="home-hero__actions">
          <a href="/works" class="btn btn--primary">SEE THE WORK →</a>
          <a href="/services" class="btn btn--ink">WHAT WE DO</a>
        </div>
      </div>
    </div>

    <div class="home-status container">
      <div class="home-status__left">
        <span class="home-status__life">
          <i class="home-status__dot" aria-hidden="true"></i>CONWAY'S GAME OF LIFE
        </span>
        <span class="home-status__gen">GEN <b id="life-gen">0</b></span>
      </div>

      <div class="home-status__right">
        <div class="home-tray" id="life-tray">
          <button type="button" id="life-pause" class="home-tray__btn">PAUSE</button>
          <button type="button" id="life-glider" class="home-tray__btn">SPAWN GLIDER</button>
          <button type="button" id="life-restart" class="home-tray__btn">RESTART</button>
        </div>
        <a href="/about" class="home-status__info">INFO</a>
        <button
          type="button"
          id="life-toggle"
          class="home-status__toggle"
          aria-expanded="false"
          aria-controls="life-tray"
        >
          CONTROL +
        </button>
      </div>
    </div>
  </div>

  <script type="module" src="/life.js"></script>
</Layout>
