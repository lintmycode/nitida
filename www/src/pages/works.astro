---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import { twoXSrc } from '../lib/media.ts';

const works = await getCollection('works');
// `??` only falls back on null/undefined, so order: 0 (OneForma) and negative
// orders (CINCA's -1, so it leads without renumbering every other entry)
// still sort correctly ahead of unordered items.
const sortedWorks = works.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

// Cache-bust images per build so stale browser/CDN caches don't serve outdated assets.
const buildVersion = Date.now();

---

<Layout
  title="Works - NÍTIDA DIGITAL"
  description="Selected work from NÍTIDA DIGITAL — WordPress, Shopify, SEO and custom apps, built and still in production."
  active="works"
>
  <div class="works">
    <div class="container">
      <div class="works-intro">
        <div>
          <div class="eyebrow works-intro__eyebrow">SELECTED WORKS</div>
          <h1 class="h1 h1--44">Built, launched, and still alive.</h1>
          <p class="works-intro__lead">
            A selection of old and new projects that still make us proud.
          </p>
        </div>
      </div>

      <div class="works-grid">
        {sortedWorks.map((work) => {
          const { data, slug } = work;
          const twoX = data.image ? twoXSrc(data.image) : null;
          const src = data.image ? `${data.image}?v=${buildVersion}` : undefined;
          const srcset = twoX
            ? `${data.image}?v=${buildVersion} 1x, ${twoX}?v=${buildVersion} 2x`
            : undefined;
          const href = data.link?.[0] ?? '#';
          const isExternal = !href.includes('nitida.pt');
          return (
            <a
              class="work-card"
              id={slug}
              href={href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
            >
              {data.image && (
                <div class="work-card__image">
                  <img
                    src={src}
                    srcset={srcset}
                    alt={data.title}
                    style={data.backgroundPosition ? `object-position: ${data.backgroundPosition}` : undefined}
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="500"
                  />
                </div>
              )}
              <div class="work-card__body">
                <div class="work-card__heading">
                  <h3>{data.title}</h3>
                  <span class="work-card__subtitle">{data.subtitle}</span>
                </div>
                <p class="work-card__desc">{data.description}</p>
                <div class="work-card__footer">
                  <span class="work-card__tech">{data.technologies.join(' · ').toUpperCase()}</span>
                  {data.link && <span class="work-card__link">{data.link[1].toUpperCase()} ↗</span>}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>

</Layout>
