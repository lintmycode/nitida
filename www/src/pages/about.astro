---
import Layout from '../components/Layout.astro';

// Copy verbatim from renderVals().principles in the mockup (mockup artboard
// 1g). Kept local since it's only used on this one page.
const principles = [
  {
    tag: 'FOCUS',
    title: 'Simple by design',
    body: 'A few projects at a time, each with full attention. Spec it accurately, build it right, deliver it fast.',
  },
  {
    tag: 'TECH',
    title: 'Trendless',
    body: "We know the stack behind the latest shiny thing. Odds are we built something like it years ago.",
  },
  {
    tag: 'SOLID',
    title: 'Longevity',
    body: 'Clean code, sane updates, no fragile hacks. Built to still work in ten years. So are we.',
  },
];
---

<Layout
  title="About - NÍTIDA DIGITAL"
  description="A small studio in Portugal that builds for clients around the world: ten years of WordPress, Shopify and web work, still maintained after launch."
  active="about"
  cta="contact"
>
  <div class="container container--narrow about">
    <section class="about-intro">
      <p class="eyebrow about-intro__eyebrow">ABOUT NÍTIDA</p>
      <h1 class="h1 h1--40 about-intro__title">
        A small studio in Portugal that builds for clients around the world.
      </h1>
      <p class="about-intro__lead">
        Ten years as NÍTIDA, twenty in the trade. WordPress and Shopify done properly,
        integrations that hold, and work we're still maintaining years after launch.
      </p>
    </section>

    <div class="about-principles">
      {
        principles.map((p) => (
          <div class="about-principles__card">
            <div class="about-principles__tag">{p.tag}</div>
            <h3 class="about-principles__title">{p.title}</h3>
            <p class="about-principles__body">{p.body}</p>
          </div>
        ))
      }
    </div>

    <div class="about-grid-box">
      {
        /* Decorative echo of the homepage's Game of Life grid; the copy
           beside it explains the reference, so the square itself carries
           no information for assistive tech. */
      }
      <div class="about-grid-box__square" aria-hidden="true"></div>
      <div class="about-grid-box__text">
        <h3>About that grid on the homepage</h3>
        <p>
          Conway's Game of Life: a grid of cells, four simple rules, and complex outcomes that
          keep growing. The patterns never repeat. The homepage is never the same twice. Neither
          are the projects.
        </p>
        <p>
          A reminder that simple systems, built well, go a long way. Also, it's fun to watch.
        </p>
      </div>
    </div>
  </div>
</Layout>
