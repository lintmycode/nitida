---
import Layout from '../components/Layout.astro';

// Privacy notice, copied from maumarketing.pt/en/privacy (same controller,
// NÍTIDA DIGITAL) and kept in step with it. Differences from MAU, on purpose:
// - nitida.pt has no cookie banner yet, so GA4 loads for everyone (see
//   Layout.astro). The "only if you accept cookies" lines are rewritten to
//   match; restore MAU's wording if MAU's ConsentBanner is ported here.
// - The form also sends the ticked "needs", so they're listed in s2.
// Bodies are trusted strings that may hold links, hence set:html.
const EMAIL = 'info@nitida.pt';
const mail = `<a href="mailto:${EMAIL}">${EMAIL}</a>`;

const sections = [
  {
    h: 'Who handles the data',
    p: `NÍTIDA DIGITAL. Contact: ${mail}.`,
  },
  {
    h: 'What data we collect',
    p: 'What you give us in the contact form: name, email, the needs you tick and your message. Google Analytics collects usage data: pages viewed, where you came from, device and approximate location. We use no advertising cookies.',
  },
  {
    h: 'What it is for',
    p: 'Replying to your message, preparing proposals, delivering the services you hire and understanding how the site is used. We never sell data to anyone.',
  },
  {
    h: 'Legal basis',
    p: 'Your consent (when you submit the form), pre-contractual steps taken at your request, and our legitimate interest in knowing how the site is used, under the GDPR.',
  },
  {
    h: 'How long we keep it',
    p: 'Up to 24 months after the last contact. If you become a client, for the duration of the contract and the applicable legal periods (for example, tax). Google Analytics data is kept for at most 14 months.',
  },
  {
    h: 'Who we share it with',
    p: 'EmailJS, which sends the form messages (a service based outside the EU); Google, through Google Analytics (it may transfer data outside the EU); our email provider; and the site hosting. Google Fonts loads the site fonts, so your IP address is visible to Google.',
  },
  {
    h: 'Cookies',
    p: 'We only use the Google Analytics cookies (_ga and _ga_*, up to 2 years). You can block them in your browser settings or with Google’s <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">opt-out add-on</a>.',
  },
  {
    h: 'Your rights',
    p: `You have the right to access, rectification, erasure, restriction, portability and objection. To exercise any of them, write to ${mail}. You can also complain to the Portuguese data protection authority, CNPD (<a href="https://www.cnpd.pt" target="_blank" rel="noopener">cnpd.pt</a>), or use the <a href="https://www.livroreclamacoes.pt" target="_blank" rel="noopener">Complaints Book</a>.`,
  },
];
---

<Layout
  title="Privacy - NÍTIDA DIGITAL"
  description="What data we collect, what it is for, who we share it with and what your rights are."
  cta="contact"
>
  <div class="container container--narrow privacy">
    <header class="privacy__intro">
      <p class="eyebrow privacy__eyebrow">UPDATED 11/11/2026</p>
      <h1 class="h1 h1--40">Privacy</h1>
      <p class="privacy__lede">The boring part. But it matters, so it's here.</p>
    </header>

    <div class="privacy__sections">
      {sections.map((s) => (
        <section>
          <h2>{s.h}</h2>
          <p set:html={s.p} />
        </section>
      ))}
    </div>
  </div>
</Layout>
