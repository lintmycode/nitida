---
import Layout from '../components/Layout.astro';
import { needs } from '../data/services';

// Slugs for each `needs[]` entry, same order as src/data/services.ts.
// Used as stable checkbox ids and to support `?need=<slug>` pre-checking a
// chip from a link (no page uses it since the Services band went, but the
// mechanism stays for future links).
const needSlugs = ['wordpress', 'shopify', 'app', 'seo', 'ai', 'rescue', 'care', 'other'];
---

<Layout
  title="Contact - NÍTIDA DIGITAL"
  description="Tell us about the project."
  active="contact"
  cta="contact"
>
  <div class="container container--narrow contact">
    <div class="contact__intro">
      <div class="eyebrow contact__eyebrow">CONTACT</div>
      <h1 class="h1 h1--38 contact__h1">Tell us about the project.</h1>
      <p class="contact__reply">A few lines are enough to start. Details can come later.</p>
    </div>

    <div class="contact__grid">
      <div class="contact__form-card">
        <form id="contact-form" novalidate>
          <div class="contact__row contact__row--2">
            <div class="contact__field">
              <label for="name" class="contact__label">NAME</label>
              <input
                type="text"
                id="name"
                name="name"
                class="contact__input"
                placeholder="Your name"
                required
                aria-describedby="name-error"
              />
              <p class="contact__error" id="name-error" hidden></p>
            </div>
            <div class="contact__field">
              <label for="email" class="contact__label">EMAIL</label>
              <input
                type="email"
                id="email"
                name="email"
                class="contact__input"
                placeholder="you@company.com"
                required
                aria-describedby="email-error"
              />
              <p class="contact__error" id="email-error" hidden></p>
            </div>
          </div>

          <div class="contact__field contact__field--needs">
            <span class="contact__label">WHAT DO YOU NEED?</span>
            <div class="contact__chips">
              {
                needs.map((need, i) => (
                  <div class="contact__chip">
                    <input
                      type="checkbox"
                      id={`need-${needSlugs[i]}`}
                      name="needs"
                      value={need}
                      class="contact__chip-input"
                      data-slug={needSlugs[i]}
                    />
                    <label for={`need-${needSlugs[i]}`} class="contact__chip-label">
                      {need}
                    </label>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="contact__field contact__field--project">
            <label for="project" class="contact__label">THE PROJECT</label>
            <textarea
              id="project"
              name="project"
              class="contact__textarea"
              placeholder="What it is, who it's for, and what's in the way."
              required
              aria-describedby="project-error"
            ></textarea>
            <p class="contact__error" id="project-error" hidden></p>
          </div>

          <div class="contact__submit-row">
            <button type="submit" class="btn btn--primary contact__submit" id="contact-submit">
              <span class="contact__submit-label">SEND ENQUIRY →</span>
            </button>
            <span class="contact__small-print">NO NEWSLETTER. NO SPAM.</span>
          </div>

          <p class="contact__status" id="contact-status" aria-live="polite"></p>
        </form>
      </div>

      <div class="contact__side">
        <div class="contact__side-card">
          <div class="contact__side-heading">DIRECT</div>
          <a href="mailto:info@nitida.pt" class="contact__side-link contact__side-link--lime">info@nitida.pt</a>
          <a
            href="https://linkedin.com/in/nunomp"
            target="_blank"
            rel="noopener noreferrer"
            class="contact__side-link"
          >
            LinkedIn ↗
          </a>
          <a
            href="https://github.com/lintmycode"
            target="_blank"
            rel="noopener noreferrer"
            class="contact__side-link"
          >
            GitHub ↗
          </a>
        </div>
        <div class="contact__side-card">
          <div class="contact__side-heading">BASED</div>
          <p class="contact__side-text">Portugal (WET/WEST). We work with teams across Europe and the US.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<script>
  // Same EmailJS project as the pre-redesign contact.astro — public key,
  // service and template IDs are unchanged (redesign-spec.md "Handler").
  const EMAILJS_PUBLIC_KEY = '35n5lDzpu_p_TvSBF';
  const EMAILJS_SERVICE_ID = 'service_wcvn6c8';
  const EMAILJS_TEMPLATE_ID = 'template_7g6zm0p';

  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('contact-submit');
  const submitLabel = submitBtn?.querySelector('.contact__submit-label');
  const statusEl = document.getElementById('contact-status');

  // A Services-page CTA can link here with ?need=care to pre-check the
  // matching "What do you need?" chip (spec: "?need=care pre-checks
  // Hosting & care"). Read from location.search on the client, since this
  // is a static build and the query string only exists at request time.
  const needParam = new URLSearchParams(window.location.search).get('need');
  if (needParam) {
    const chip = form?.querySelector(`.contact__chip-input[data-slug="${CSS.escape(needParam)}"]`);
    if (chip) chip.checked = true;
  }

  // Validates one required/typed field against the native constraint API
  // (form has novalidate, so this replaces the browser's default bubble)
  // and shows/hides the inline error text under it.
  function validateField(field, messages) {
    const errorEl = document.getElementById(`${field.id}-error`);
    const valid = field.checkValidity();

    if (!valid) {
      const message = field.validity.valueMissing ? messages.missing : messages.invalid || messages.missing;
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }
      field.setAttribute('aria-invalid', 'true');
    } else {
      if (errorEl) {
        errorEl.textContent = '';
        errorEl.hidden = true;
      }
      field.removeAttribute('aria-invalid');
    }

    return valid;
  }

  // emailjs.init() only needs to run once the CDN script has parsed; the
  // script tag above is synchronous so this normally succeeds on the first
  // try, but the short retry loop keeps it robust either way.
  function initEmailJS() {
    if (typeof emailjs !== 'undefined') {
      emailjs.init(EMAILJS_PUBLIC_KEY);
    } else {
      setTimeout(initEmailJS, 100);
    }
  }

  function setupForm() {
    if (!(form instanceof HTMLFormElement) || !submitBtn || !submitLabel || !statusEl) return;

    const nameField = document.getElementById('name');
    const emailField = document.getElementById('email');
    const projectField = document.getElementById('project');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const nameValid = validateField(nameField, { missing: 'Enter your name.' });
      const emailValid = validateField(emailField, {
        missing: 'Enter your email.',
        invalid: 'Enter a valid email address.',
      });
      const projectValid = validateField(projectField, { missing: 'Add a few words about the project.' });

      if (!nameValid || !emailValid || !projectValid) {
        // Focus the first invalid field so it's announced/visible.
        (!nameValid ? nameField : !emailValid ? emailField : projectField).focus();
        return;
      }

      const checkedNeeds = Array.from(form.querySelectorAll('input[name="needs"]:checked')).map((el) => el.value);
      const needsJoined = checkedNeeds.join(', ');

      // subject/message built exactly per redesign-spec.md "Handler", so the
      // existing EmailJS template's {{subject}}/{{message}} keep working.
      const subject = needsJoined ? `Project enquiry: ${needsJoined}` : 'Project enquiry';
      const message = `${projectField.value}\n\nNeeds: ${needsJoined || '—'}`;

      submitBtn.setAttribute('disabled', 'true');
      submitLabel.textContent = 'SENDING…';
      statusEl.textContent = '';
      statusEl.removeAttribute('data-state');

      try {
        const result = await emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEMPLATE_ID, {
          name: nameField.value,
          email: emailField.value,
          subject,
          message,
        });

        if (result.status === 200) {
          statusEl.textContent = 'Message sent. Talk soon.';
          statusEl.setAttribute('data-state', 'success');
          form.reset();
        } else {
          throw new Error('EmailJS failed');
        }
      } catch (error) {
        console.error('EmailJS error:', error);
        statusEl.textContent = 'Failed to send. Please try again, or email info@nitida.pt directly.';
        statusEl.setAttribute('data-state', 'error');
      } finally {
        submitBtn.removeAttribute('disabled');
        submitLabel.textContent = 'SEND ENQUIRY →';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initEmailJS();
      setupForm();
    });
  } else {
    initEmailJS();
    setupForm();
  }
</script>
