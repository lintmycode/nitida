---
// Shared site header. Transparent over the page ground (README §Global components).
//
// Props:
// - active: which nav link (if any) is current, gets aria-current + the
//   persistent underline.
// - cta: 'project' (default, "START A PROJECT") or 'contact' ("CONTACT"),
//   per the CTA rule in redesign-spec.md — every CTA goes to /contact.
interface Props {
  active?: 'services' | 'works' | 'about' | 'contact' | null;
  cta?: 'project' | 'contact';
}

const { active = null, cta = 'project' } = Astro.props;

const ctaLabel = cta === 'contact' ? 'CONTACT' : 'START A PROJECT';

const links = [
  { key: 'services', href: '/services', label: 'SERVICES' },
  { key: 'works', href: '/works', label: 'WORKS' },
  { key: 'about', href: '/about', label: 'ABOUT' },
];
---

<header class="site-header">
  <div class="container site-header__row">
    <a href="/" class="site-header__logo">
      <img src="/logo-lime.png" alt="NÍTIDA" width="36" height="62" />
    </a>

    <nav class="site-header__nav" id="site-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="site-header__link"
            aria-current={active === link.key ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {/* Mobile-only copy of the header CTA: on phones the CTA lives in the
          menu panel instead of the header row (see _header.scss). */}
      <a href="/contact" class="btn btn--primary site-header__nav-cta">{ctaLabel}</a>
    </nav>

    <div class="site-header__actions">
      <button
        type="button"
        class="site-header__menu"
        id="site-nav-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        MENU
      </button>
      <a href="/contact" class="btn btn--primary site-header__cta">{ctaLabel}</a>
    </div>
  </div>
</header>

<script>
  // Mobile nav toggle: shows/hides the panel, keeps aria-expanded in sync,
  // and closes on Escape. Only relevant at <=640px (see _header.scss);
  // harmless no-op the rest of the time.
  const toggle = document.getElementById('site-nav-toggle');
  const nav = document.getElementById('site-nav');

  if (toggle && nav) {
    // Page scroll is locked while open (html.nav-open) so the overlay under
    // the panel always covers what's visible.
    const setOpen = (isOpen: boolean) => {
      nav.classList.toggle('is-open', isOpen);
      document.documentElement.classList.toggle('nav-open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
    };
    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
    // A tap on the overlay (the nav's ::after) targets the nav element itself.
    nav.addEventListener('click', (e) => {
      if (e.target === nav) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
