---
// Shared site footer — ink band, shown on every page including Home
// (redesign-spec.md §Footer). No NIF: dropped from the design.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div>
        <a href="/" aria-label="NÍTIDA home" class="site-footer__logo-link"><img src="/logo-white.png" alt="" width="31" height="54" class="site-footer__logo" /></a>
        <p class="site-footer__tagline">Digital work for clients with a vision.</p>
      </div>

      <div class="site-footer__col">
        <div class="site-footer__heading">Nav</div>
        <a href="/services">Services</a>
        <a href="/works">Works</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </div>

      <div class="site-footer__col">
        <div class="site-footer__heading">Connect</div>
        <a href="mailto:info@nitida.pt">info@nitida.pt</a>
        <a href="https://linkedin.com/in/nunomp" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href="https://github.com/lintmycode" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </div>

    <div class="site-footer__legal">
      &copy; {year} NÍTIDA DIGITAL
    </div>
  </div>
</footer>
